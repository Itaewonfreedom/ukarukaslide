<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ukaruka"
            android:textSize="32sp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.04"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slide / 로컬 사진 화면 보호기"
            android:textSize="12sp"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="24dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앨범"
            android:textSize="13sp"
            android:textColor="@color/ink_muted" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앨범을 선택하세요"
            android:textSize="26sp"
            android:textColor="@color/ink"
            android:id="@+id/sourceTitle"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-light"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기기에 저장된 사진으로 시작합니다."
            android:textSize="14sp"
            android:textColor="@color/ink_muted"
            android:id="@+id/sourceDetail"
            android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAlbumsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:text="앨범·폴더 선택"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/ink"
            app:cornerRadius="4dp"
            app:strokeColor="@color/outline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:text="슬라이드 재생"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/background"
            app:cornerRadius="4dp"
            app:strokeColor="@color/outline"
            app:backgroundTint="@color/ink"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="24dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="재생"
            android:textSize="20sp"
            android:textColor="@color/ink" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="사진 한 장의 표시 시간"
            android:textSize="13sp"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="18dp"/>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/intervalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/interval10"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="10초"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/interval15"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="15초"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/interval30"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="30초"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="재생 순서"
            android:textSize="13sp"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="24dp"/>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/playbackOrderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/orderRandom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="랜덤"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/orderChronological"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="오래된 순"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/orderReverse"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_weight="1"
                android:text="최신 순"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:cornerRadius="4dp"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="오래된 순·최신 순은 시간순으로 정렬한 뒤\n24장씩 묶어 섞습니다."
            android:textSize="12sp"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="24dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="화면"
            android:textSize="20sp"
            android:textColor="@color/ink" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/styleSettingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:text="시계와 날짜"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/ink"
            app:cornerRadius="4dp"
            app:strokeColor="@color/outline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dreamSettingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:text="시스템 화면 보호기 설정"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/ink"
            app:cornerRadius="4dp"
            app:strokeColor="@color/outline" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기기 안의 사진만 사용합니다. 계정 연결은 필요 없습니다."
            android:textSize="12sp"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
